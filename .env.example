# Token bot dari @BotFather
BOT_TOKEN=123456:ABC...

# User ID Telegram pemilik bot (dapatkan dari @userinfobot).
# Pemilik yang boleh menyetel API key AI dan perintah global.
OWNER_ID=123456789

# Direktori data (SQLite + cache katalog model). Default: ./data
# DATA_DIR=./data

# API key AI bisa juga lewat env (fallback bila belum disetel via Telegram).
# Nama variabel mengikuti field `env` di models.dev, contoh:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
