# Bot token from @BotFather (required)
BOT_TOKEN=123456:ABC...

# Telegram user id of the bot owner (get it from /id or @userinfobot).
# Accepts a comma-separated list; the FIRST id is the primary owner and is the
# only one allowed to manage the owner team (/addowner) and store API keys
# (/setkey). The rest get the day-to-day owner commands
# (/status /broadcast /export /update /refund /spend).
# More co-owners can be added at runtime with /addowner <user_id>.
OWNER_ID=123456789

# Data directory (SQLite + model-catalog cache). Default: ./data
# DATA_DIR=./data

# Encryption key for stored provider API keys.
# Defaults to a key derived from BOT_TOKEN — set your own for extra safety.
# SECRET_KEY=change-me

# Default AI model when a chat has not picked its own via /aimodel.
# DEFAULT_AI_PROVIDER=anthropic
# DEFAULT_AI_MODEL=claude-opus-5

# AI API keys can also come from env (fallback when not set via Telegram).
# Variable names follow the `env` field on models.dev, e.g.:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...

# Webhook mode: set a public HTTPS URL to switch from long polling
# (required for multiple replicas). PORT is the local HTTP port.
# WEBHOOK_URL=https://bot.example.com/telegram
# PORT=8080
# WEBHOOK_SECRET=optional-shared-secret

# Public HTTPS base of this bot's own HTTP server — enables the self-hosted
# Mini App captcha for guard-bot join requests (works in polling mode too).
# WEBAPP_URL=https://bot.example.com

# Self-update: "true" applies git updates automatically every hour and
# restarts; anything else only notifies the owner that /update is available.
# AUTO_UPDATE=false

# Operational alerting — every owner is DMed when a threshold is crossed, and
# once more when it clears. Set either to 0 to disable that check.
# ALERT_ERRORS_PER_5M=25
# ALERT_JOB_BACKLOG=50
